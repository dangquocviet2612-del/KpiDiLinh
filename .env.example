# ====================================================================
# CUSTOMER MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env containing real secrets to version control.

# --------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Turso / libSQL / SQLite)
# --------------------------------------------------------------------
# Local SQLite:
# DATABASE_URL="file:dev.db"

# Turso Cloud (Remote libSQL):
DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token"

# Enable verbose Prisma query logging (optional: true / false)
PRISMA_DEBUG="false"

# --------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (NextAuth v5)
# --------------------------------------------------------------------
# Generate a secure 32-byte secret with: openssl rand -base64 32
AUTH_SECRET="your-generated-auth-secret"

# Secret required to trigger automated monthly archive purging via /api/archive/cron
# CRON_SECRET is automatically passed by Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="your-secure-cron-secret"
# ARCHIVE_CRON_SECRET can be used for custom external runners / GitHub Actions
ARCHIVE_CRON_SECRET="your-secure-archive-cron-secret"

# --------------------------------------------------------------------
# 3. OPTIONAL DATA SEEDING (Leave empty in production)
# --------------------------------------------------------------------
# Optional local Excel file paths for initial bootstrap data
NODE_0TB_DEFAULT_FILE_PATH=""
CUOC_CD_DEFAULT_FILE_PATH=""
